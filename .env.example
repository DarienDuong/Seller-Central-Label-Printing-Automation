# Copy to .env and fill in. .env is gitignored — never commit real values.

# Seller Central regional host (no trailing slash)
SC_BASE_URL=https://sellercentral.amazon.com

# Display text of the marketplace row in Amazon's account-switcher screen.
# `npm run login` clicks through it once so the selection is saved into the
# session; a run only needs this again if the saved session ever loses it.
SC_MARKETPLACE_NAME=United States

# Where the saved browser session (cookies + localStorage) lives.
# Created by `npm run login`. Treat it like a password.
SC_STORAGE_STATE=.auth/seller-central.json

# Where downloaded label PDFs are written.
OUTPUT_DIR=output

# headed | headless — run headed for login and while developing selectors.
BROWSER_MODE=headed

# Slow every Playwright action by N ms. Useful when debugging.
SLOW_MO=0

# Default label layout. One of: ItemLabel_Letter_30, ItemLabel_A4_27,
# ItemLabel_A4_24, ItemLabel_A4_21, ItemLabel_A4_40_52x29,
# ItemLabel_A4_44_48x25, or thermal (freeform size via thermalWidthMm/thermalHeightMm).
DEFAULT_LABEL_FORMAT=ItemLabel_Letter_30

# Optional: CUPS printer name for auto-printing (see `lpstat -p`).
# Leave blank to only download the PDF.
PRINTER_NAME=
